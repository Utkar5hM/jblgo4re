{
  "permissions": {
    "allow": [
      "Bash(tools/gh.sh:*)",
      "Bash(tools/build_index.sh:*)",
      "Bash(tools/q.sh:*)",
      "Bash(python3 tools/extract_fw.py:*)",
      "Bash(python3 tools/extract_coolflux.py:*)",
      "Bash(python3 tools/repack_fw.py:*)",
      "Bash(.venv/bin/python tools/ble_probe.py:*)",
      "Bash(grep:*)", "Bash(rg:*)", "Bash(awk:*)", "Bash(sort:*)", "Bash(xxd:*)", "Bash(sha256sum:*)",
      "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)", "Bash(git show:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [ { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard.sh" } ] }
    ]
  }
}
